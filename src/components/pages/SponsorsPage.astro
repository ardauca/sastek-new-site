---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../ui/PageHero.astro';
import { sponsors as staticSponsors } from '../../data/sponsors';
import type { Locale } from '../../types/content';

interface Props { locale: Locale; }
const { locale } = Astro.props;

let rawSponsors: any[] = [];
let showNotice = true;

try {
  const [response, setRes] = await Promise.all([
    fetch('https://admin.sastek.org/api/sponsors', { headers: { 'Accept': 'application/json' } }),
    fetch('https://admin.sastek.org/api/settings', { headers: { 'Accept': 'application/json' } })
  ]);
  if (response.ok) {
    const apiSponsors = await response.json();
    if (Array.isArray(apiSponsors) && apiSponsors.length > 0) {
      rawSponsors = apiSponsors;
    }
  }
  if (setRes.ok) {
    const settings = await setRes.json();
    if (settings.show_sponsors_notice === 0 || settings.show_sponsors_notice === false) showNotice = false;
  }
} catch (e) {
  // Fallback to static
}

if (!rawSponsors.length) {
  rawSponsors = staticSponsors.map(s => ({
    id: s.id,
    name: s.name,
    tier: s.tier === 'ana-sponsor' ? 'platinum' : 'standard',
    logo_url: s.logo,
    website: s.websiteUrl || null,
    sort_order: s.order || 0,
    is_active: s.isActive ? 1 : 0
  }));
}

const activeSponsors = rawSponsors
  .filter(s => s.is_active === 1 || s.is_active === true)
  .sort((a, b) => (a.sort_order ?? 0) - (b.sort_order ?? 0));

function normalizeTier(tierStr: string): string {
  const t = String(tierStr || '').toLowerCase();
  if (t === 'platinum' || t === 'ana-sponsor') return 'platinum';
  if (t === 'gold' || t === 'altin') return 'gold';
  if (t === 'silver' || t === 'gumus') return 'silver';
  return 'standard';
}

const TIER_ORDER = [
  { key: 'platinum', title: { tr: 'Ana Sponsorlar', en: 'Main Sponsors' } },
  { key: 'gold',     title: { tr: 'Altın Sponsorlar', en: 'Gold Sponsors' } },
  { key: 'silver',   title: { tr: 'Gümüş Sponsorlar', en: 'Silver Sponsors' } },
  { key: 'standard', title: { tr: 'Destekçiler', en: 'Supporters' } }
];

const groupedSponsors = TIER_ORDER.map(t => ({
  key: t.key,
  title: t.title[locale],
  sponsors: activeSponsors.filter(s => normalizeTier(s.tier) === t.key)
})).filter(g => g.sponsors.length > 0);

const title = locale === 'tr' ? 'Sponsorlarımız' : 'Our Sponsors';
const desc  = locale === 'tr' ? 'Öğrencilerin teknolojiyle buluşmasına katkı sağlayan destekçilerimiz.' : 'Our supporters helping students connect with technology.';
---

<BaseLayout title={title} description={desc} locale={locale}>
  <PageHero eyebrow={locale === 'tr' ? 'SASTEK / SPONSORLAR' : 'SASTEK / SPONSORS'} title={title} text={desc} />
  <section class="section">
    <div class="container" data-sponsors-root data-locale={locale} data-api="https://admin.sastek.org/api">
      <div class="notice" id="sponsors-notice-banner" style={showNotice ? '' : 'display:none;'}>
        {locale === 'tr' ? 'Sponsor kayıtları doğrulanmış güncel liste ile değiştirilmek üzere örnek olarak gösterilmektedir.' : 'Sponsor entries are samples pending replacement with a verified current list.'}
      </div>

      <div id="sponsors-groups-container">
        {groupedSponsors.length === 0 ? (
          <p class="empty-msg">{locale === 'tr' ? 'Aktif sponsor bulunamadı.' : 'No active sponsors found.'}</p>
        ) : (
          groupedSponsors.map((group) => (
            <div class={`tier-group tier-${group.key}`}>
              <div class="tier-header">
                <h2 class="tier-title">{group.title}</h2>
                <div class="tier-line" />
              </div>
              <div class="tier-logos">
                {group.sponsors.map((sponsor) => {
                  let logo = sponsor.logo_url || '/images/sponsors/sample-sponsor.png';
                  if (logo.startsWith('/images/')) logo = 'https://sastek.org' + logo;
                  const inner = (
                    <img src={logo} alt={`${sponsor.name} logo`} loading="lazy" />
                  );
                  return sponsor.website ? (
                    <a href={sponsor.website} target="_blank" rel="noopener noreferrer" class="sponsor-link-box" title={sponsor.name}>
                      {inner}
                    </a>
                  ) : (
                    <div class="sponsor-link-box" title={sponsor.name}>
                      {inner}
                    </div>
                  );
                })}
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </section>

  <section class="section support">
    <div class="container support-inner">
      <div>
        <p class="eyebrow">{locale === 'tr' ? 'İŞ BİRLİĞİ' : 'COLLABORATE'}</p>
        <h2 class="title">{locale === 'tr' ? 'Geleceğin mühendislerine birlikte alan açalım.' : 'Let’s create opportunities for future engineers.'}</h2>
      </div>
      <a class="btn btn-primary" href={locale === 'tr' ? '/iletisim' : '/en/contact'}>{locale === 'tr' ? 'İletişime geç' : 'Get in touch'} →</a>
    </div>
  </section>
</BaseLayout>

<script>
  (async () => {
    const root = document.querySelector<HTMLElement>('[data-sponsors-root]');
    if (!root) return;
    const pageLocale = (root.dataset.locale || 'tr') as 'tr' | 'en';
    const apiBase = root.dataset.api || 'https://admin.sastek.org/api';
    const container = document.getElementById('sponsors-groups-container');
    if (!container) return;

    function escapeHtml(value: string) {
      return String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    }

    function normalizeTier(tierStr: string): string {
      const t = String(tierStr || '').toLowerCase();
      if (t === 'platinum' || t === 'ana-sponsor') return 'platinum';
      if (t === 'gold' || t === 'altin') return 'gold';
      if (t === 'silver' || t === 'gumus') return 'silver';
      return 'standard';
    }

    const TIER_ORDER = [
      { key: 'platinum', title: { tr: 'Ana Sponsorlar', en: 'Main Sponsors' } },
      { key: 'gold',     title: { tr: 'Altın Sponsorlar', en: 'Gold Sponsors' } },
      { key: 'silver',   title: { tr: 'Gümüş Sponsorlar', en: 'Silver Sponsors' } },
      { key: 'standard', title: { tr: 'Destekçiler', en: 'Supporters' } }
    ];

    try {
      const [res, setRes] = await Promise.all([
        fetch(`${apiBase}/sponsors`),
        fetch(`${apiBase}/settings`)
      ]);

      if (setRes.ok) {
        const settings = await setRes.json();
        const banner = document.getElementById('sponsors-notice-banner');
        if (banner) banner.style.display = (settings.show_sponsors_notice === 1 || settings.show_sponsors_notice === true) ? 'block' : 'none';
      }

      if (!res.ok) return;
      const sponsors = await res.json();
      if (!Array.isArray(sponsors)) return;

      const active = sponsors
        .filter((s: any) => s.is_active === 1 || s.is_active === true)
        .sort((a: any, b: any) => (a.sort_order ?? 0) - (b.sort_order ?? 0));

      if (active.length === 0) {
        container.innerHTML = `<p class="empty-msg">${pageLocale === 'tr' ? 'Aktif sponsor bulunamadı.' : 'No active sponsors found.'}</p>`;
        return;
      }

      const grouped = TIER_ORDER.map(t => ({
        key: t.key,
        title: t.title[pageLocale],
        sponsors: active.filter((s: any) => normalizeTier(s.tier) === t.key)
      })).filter(g => g.sponsors.length > 0);

      container.innerHTML = grouped.map(group => `
        <div class="tier-group tier-${escapeHtml(group.key)}">
          <div class="tier-header">
            <h2 class="tier-title">${escapeHtml(group.title)}</h2>
            <div class="tier-line"></div>
          </div>
          <div class="tier-logos">
            ${group.sponsors.map((sponsor: any) => {
              let logo = sponsor.logo_url || '/images/sponsors/sample-sponsor.png';
              if (logo.startsWith('/images/')) logo = 'https://sastek.org' + logo;
              const imgHtml = `<img src="${escapeHtml(logo)}" alt="${escapeHtml(sponsor.name)} logo" loading="lazy" />`;
              if (sponsor.website) {
                return `<a href="${escapeHtml(sponsor.website)}" target="_blank" rel="noopener noreferrer" class="sponsor-link-box" title="${escapeHtml(sponsor.name)}">${imgHtml}</a>`;
              }
              return `<div class="sponsor-link-box" title="${escapeHtml(sponsor.name)}">${imgHtml}</div>`;
            }).join('')}
          </div>
        </div>
      `).join('');
    } catch {}
  })();
</script>

<style>
  #sponsors-groups-container {
    margin-top: 2.5rem;
  }
  :global(.tier-group) {
    margin-bottom: 3.5rem;
  }
  :global(.tier-header) {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }
  :global(.tier-title) {
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ff9a62;
    margin: 0;
    white-space: nowrap;
  }
  :global(.tier-line) {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, rgba(255, 154, 98, 0.35), rgba(84, 119, 151, 0.15), transparent);
  }
  :global(.tier-logos) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 270px));
    gap: 1.5rem 1.75rem;
    align-items: center;
  }
  :global(.sponsor-link-box) {
    width: 100%;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.6rem;
    border-radius: 0.85rem;
    background: #ffffff;
    border: 1px solid rgba(130, 164, 196, 0.28);
    box-shadow: 0 10px 24px -6px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    overflow: hidden;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
  }
  :global(.sponsor-link-box:hover) {
    transform: translateY(-2px);
    border-color: rgba(0, 212, 255, 0.5);
    box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.45), 0 0 20px -4px rgba(0, 212, 255, 0.25);
  }
  :global(.sponsor-link-box img) {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    transform: scale(1.4);
    transform-origin: center center;
    transition: transform 0.22s ease;
  }
  :global(.sponsor-link-box:hover img) {
    transform: scale(1.48);
  }
  :global(.empty-msg) {
    text-align: center;
    color: #a9bbce;
    margin: 3rem auto;
    font-size: 0.95rem;
  }
  .support {
    background: rgba(7, 21, 38, 0.7);
  }
  .support-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .support-inner h2 {
    max-width: 760px;
  }
  @media (max-width: 700px) {
    .support-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (max-width: 600px) {
    :global(.tier-logos) {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
    :global(.sponsor-link-box) {
      height: 85px;
      padding: 0.3rem 0.5rem;
      border-radius: 0.75rem;
    }
    :global(.sponsor-link-box img) {
      transform: scale(1.35);
    }
  }
</style>
