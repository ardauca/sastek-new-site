---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../ui/PageHero.astro';
import { sponsors as staticSponsors } from '../../data/sponsors';
import type { Locale } from '../../types/content';

interface Props { locale: Locale; }
const { locale } = Astro.props;

let rawSponsors: any[] = [];
try {
  const response = await fetch('https://admin.sastek.org/api/sponsors', {
    headers: { 'Accept': 'application/json' },
  });
  if (response.ok) {
    const apiSponsors = await response.json();
    if (Array.isArray(apiSponsors) && apiSponsors.length > 0) {
      rawSponsors = apiSponsors;
    }
  }
} catch (e) {
  // Fallback to static
}

if (!rawSponsors.length) {
  rawSponsors = staticSponsors.map(s => ({
    id: s.id,
    name: s.name,
    tier: s.tier === 'ana-sponsor' ? 'platinum' : 'standard',
    logo_url: s.logo,
    website: s.website || null,
    is_active: s.isActive ? 1 : 0
  }));
}

const activeSponsors = rawSponsors.filter(s => s.is_active === 1 || s.is_active === true);

const tierLabels: Record<string, Record<Locale, string>> = {
  'platinum': { tr: 'Ana Sponsor', en: 'Main Sponsor' },
  'gold':     { tr: 'Altın Sponsor', en: 'Gold Sponsor' },
  'silver':   { tr: 'Gümüş Sponsor', en: 'Silver Sponsor' },
  'standard': { tr: 'Destekçi', en: 'Supporter' },
  'ana-sponsor': { tr: 'Ana Sponsor', en: 'Main Sponsor' },
};

const title = locale === 'tr' ? 'Sponsorlarımız' : 'Our Sponsors';
const desc  = locale === 'tr' ? 'Öğrencilerin teknolojiyle buluşmasına katkı sağlayan destekçilerimiz.' : 'Our supporters helping students connect with technology.';
---

<BaseLayout title={title} description={desc} locale={locale}>
  <PageHero eyebrow="SASTEK / SPONSORS" title={title} text={desc} />
  <section class="section">
    <div class="container" data-sponsors-root data-locale={locale} data-api="https://admin.sastek.org/api">
      <div class="notice">
        {locale === 'tr' ? 'Sponsor kayıtları doğrulanmış güncel liste ile değiştirilmek üzere örnek olarak gösterilmektedir.' : 'Sponsor entries are samples pending replacement with a verified current list.'}
      </div>

      <div class="sponsors" id="sponsors-grid-container">
        {activeSponsors.map((sponsor) => (
          <article class="glass">
            <span class="tier">{(tierLabels[sponsor.tier] || tierLabels['standard'])[locale]}</span>
            <div class="logo">
              <img src={sponsor.logo_url?.startsWith('/images/') ? 'https://sastek.org' + sponsor.logo_url : (sponsor.logo_url || '/images/sponsors/sample-sponsor.png')} alt={`${sponsor.name} logo`} loading="lazy" />
            </div>
            <h2>{sponsor.name}</h2>
            {sponsor.website && <a href={sponsor.website} target="_blank" rel="noopener" class="sponsor-link">↗ {locale === 'tr' ? 'Web Sitesi' : 'Website'}</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section support">
    <div class="container support-inner">
      <div>
        <p class="eyebrow">COLLABORATE</p>
        <h2 class="title">{locale === 'tr' ? 'Geleceğin mühendislerine birlikte alan açalım.' : 'Let’s create opportunities for future engineers.'}</h2>
      </div>
      <a class="btn btn-primary" href={locale === 'tr' ? '/iletisim' : '/en/contact'}>{locale === 'tr' ? 'İletişime geç' : 'Get in touch'} →</a>
    </div>
  </section>
</BaseLayout>

<script>
  (async () => {
    const root = document.querySelector<HTMLElement>('[data-sponsors-root]');
    if (!root) return;
    const pageLocale = (root.dataset.locale || 'tr') as 'tr' | 'en';
    const apiBase = root.dataset.api || 'https://admin.sastek.org/api';
    const gridContainer = document.getElementById('sponsors-grid-container');
    if (!gridContainer) return;

    const tierLabels: Record<string, Record<'tr'|'en', string>> = {
      'platinum': { tr: 'Ana Sponsor', en: 'Main Sponsor' },
      'gold':     { tr: 'Altın Sponsor', en: 'Gold Sponsor' },
      'silver':   { tr: 'Gümüş Sponsor', en: 'Silver Sponsor' },
      'standard': { tr: 'Destekçi', en: 'Supporter' },
    };

    function escapeHtml(value: string) {
      return String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    }

    try {
      const res = await fetch(`${apiBase}/sponsors`);
      if (!res.ok) return;
      const sponsors = await res.json();
      if (!Array.isArray(sponsors)) return;

      if (sponsors.length === 0) {
        gridContainer.innerHTML = `<p style="text-align:center;color:#a9bbce;margin:2rem auto">${pageLocale === 'tr' ? 'Aktif sponsor bulunamadı.' : 'No active sponsors found.'}</p>`;
        return;
      }

      gridContainer.innerHTML = sponsors.map((s: any) => {
        const tierText = (tierLabels[s.tier] || tierLabels['standard'])[pageLocale];
        let logo = s.logo_url || '/images/sponsors/sample-sponsor.png';
        if (logo.startsWith('/images/')) logo = 'https://sastek.org' + logo;

        const link = s.website ? `<a href="${escapeHtml(s.website)}" target="_blank" rel="noopener" class="sponsor-link">↗ ${pageLocale === 'tr' ? 'Web Sitesi' : 'Website'}</a>` : '';

        return `<article class="glass">
          <span class="tier">${escapeHtml(tierText)}</span>
          <div class="logo">
            <img src="${escapeHtml(logo)}" alt="${escapeHtml(s.name)} logo" loading="lazy" />
          </div>
          <h2>${escapeHtml(s.name)}</h2>
          ${link}
        </article>`;
      }).join('');
    } catch {}
  })();
</script>

<style>
  :global(.sponsors){display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.2rem;margin-top:2rem}
  :global(.sponsors article){text-align:center;border-radius:1.2rem;padding:1.5rem}
  :global(.sponsors .tier){color:#ff9a62;font-size:.72rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}
  :global(.sponsors .logo){display:grid;place-items:center;height:180px;margin:1rem 0;border-radius:1rem;background:#f5f5f5}
  :global(.sponsors .logo img){max-width:80%;max-height:110px;object-fit:contain}
  :global(.sponsors h2){font-size:1.05rem;margin-bottom:.4rem}
  :global(.sponsor-link){display:inline-block;font-size:.78rem;color:#00d4ff;text-decoration:none}
  :global(.sponsor-link:hover){text-decoration:underline}
  .pending{font-size:.7rem;color:#a9bbce}
  .support{background:rgba(7,21,38,.7)}
  .support-inner{display:flex;justify-content:space-between;align-items:center;gap:2rem}
  .support-inner h2{max-width:760px}
  @media(max-width:700px){.support-inner{align-items:flex-start;flex-direction:column}}
</style>
