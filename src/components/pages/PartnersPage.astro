---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../ui/PageHero.astro';
import type { Locale } from '../../types/content';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const title    = locale === 'tr' ? 'Anlaşmalı Noktalar' : 'Partners';
const desc     = locale === 'tr'
  ? 'SASTEK üyelerine özel avantaj ve kampanyaların vitrini.'
  : 'A showcase of benefits and offers exclusive to SASTEK members.';
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN ?? '';

const labels = locale === 'tr' ? {
  all:        'Tümü',
  search:     'İşletme ara…',
  empty:      'Gösterilecek anlaşmalı nokta yok.',
  loading:    'Yükleniyor…',
  error:      'Veriler yüklenemedi. Lütfen sayfayı yenileyin.',
  noOffer:    'Kampanya bilgisi güncellenecek',
  unverified: 'Doğrulama bekliyor',
  partner:    'Anlaşmalı Nokta Olmak İster misiniz?',
  partnerSub: 'SASTEK üyeleri ile iş birliği yaparak topluluğumuza katkıda bulunun.',
  contact:    'İletişime Geçin',
  grid:       'Izgara Görünüm',
  map:        'Harita Görünüm',
  openMaps:   'Haritalarda Aç',
  mapLoading: 'Harita yükleniyor…',
  mapEmpty:   'Haritada gösterilecek koordinatlı anlaşmalı nokta yok.',
  mapToken:   'Harita görünümü için PUBLIC_MAPBOX_TOKEN gerekli.',
} : {
  all:        'All',
  search:     'Search partners…',
  empty:      'No partners to display.',
  loading:    'Loading…',
  error:      'Failed to load data. Please refresh.',
  noOffer:    'Offer details to be updated',
  unverified: 'Awaiting verification',
  partner:    'Become a Partner?',
  partnerSub: 'Work with SASTEK members and contribute to our community.',
  contact:    'Contact Us',
  grid:       'Grid View',
  map:        'Map View',
  openMaps:   'Open in Maps',
  mapLoading: 'Loading map…',
  mapEmpty:   'No partners with coordinates to show on the map.',
  mapToken:   'PUBLIC_MAPBOX_TOKEN is required for the map view.',
};

const contactHref = locale === 'tr' ? '/iletisim' : '/en/contact';
---

<BaseLayout title={title} description={desc} locale={locale}>
  <PageHero eyebrow="SASTEK / PARTNERS" title={title} text={desc} />
  <section class="section">
    <div
      class="container partners-page"
      data-partners-root
      data-locale={locale}
      data-map-token={mapboxToken}
      data-labels={JSON.stringify(labels)}
      data-api="https://admin.sastek.org/api"
    >

      <!-- View Toggle -->
      <div class="view-toggle" role="group" aria-label={locale==='tr'?'Görünüm seçeneği':'View option'}>
        <button class="view-button is-active" type="button" data-view-button="grid" aria-pressed="true">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6ZM6 6v2h2V6H6Zm10 0v2h2V6h-2ZM6 16v2h2v-2H6Zm10 0v2h2v-2h-2Z"/></svg>
          {labels.grid}
        </button>
        <button class="view-button" type="button" data-view-button="map" aria-pressed="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2.75a7.25 7.25 0 0 0-7.25 7.25c0 5.1 6.45 10.87 6.73 11.11l.52.46.52-.46c.28-.24 6.73-6.01 6.73-11.11A7.25 7.25 0 0 0 12 2.75Zm0 16.67C10.5 17.95 6.25 13.45 6.25 10A5.75 5.75 0 0 1 12 4.25 5.75 5.75 0 0 1 17.75 10c0 3.45-4.25 7.95-5.75 9.42ZM12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 4.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z"/></svg>
          {labels.map}
        </button>
      </div>

      <!-- Grid View -->
      <div class="view-panel is-active" data-view-panel="grid">
        <!-- Dynamic filter bar -->
        <div class="filter-space" id="partners-filter-bar"></div>

        <!-- Cards grid — populated by JS -->
        <div class="grid-auto" id="partners-grid">
          <!-- Loading skeletons -->
          {Array.from({length:6}).map(()=>(
            <div class="partner glass skeleton-card">
              <div class="skeleton-logo"></div>
              <div class="skeleton-body">
                <div class="skeleton-line s-short"></div>
                <div class="skeleton-line s-long"></div>
                <div class="skeleton-line s-med"></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Status message (error / empty) -->
        <p class="status-msg" id="partners-status" hidden></p>
      </div>

      <!-- Map View -->
      <div class="view-panel" data-view-panel="map" hidden>
        <div class="map-shell glass">
          <div class="map-stage">
            <div id="partners-map"></div>
            <p class="map-message" id="map-message">{labels.mapLoading}</p>
          </div>
          <aside class="map-list" aria-label={labels.partner}>
            <div class="map-list-head">
              <strong>{locale==='tr'?'Haritadaki Noktalar':'Map Locations'}</strong>
              <span id="map-count">—</span>
            </div>
            <div class="map-list-items" id="map-list-items">
              <p class="empty-map">{labels.mapLoading}</p>
            </div>
          </aside>
        </div>
      </div>

      <!-- CTA -->
      <div class="partners-cta">
        <h2>{labels.partner}</h2>
        <p>{labels.partnerSub}</p>
        <a class="btn btn-primary" href={contactHref}>{labels.contact}</a>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
(async () => {
  const root      = document.querySelector<HTMLElement>('[data-partners-root]')!;
  const grid      = document.getElementById('partners-grid')!;
  const filterBar = document.getElementById('partners-filter-bar')!;
  const statusEl  = document.getElementById('partners-status')!;
  const locale    = root.dataset.locale as 'tr' | 'en';
  const API       = root.dataset.api!;
  const labels    = JSON.parse(root.dataset.labels || '{}');

  // ── View toggle ──────────────────────────────────────────────────────────────
  const viewBtns   = root.querySelectorAll<HTMLButtonElement>('[data-view-button]');
  const viewPanels = root.querySelectorAll<HTMLElement>('[data-view-panel]');
  let mapStarted   = false;

  function setView(view: string) {
    viewBtns.forEach(b => {
      const active = b.dataset.viewButton === view;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    viewPanels.forEach(p => {
      const active = p.dataset.viewPanel === view;
      p.classList.toggle('is-active', active);
      p.hidden = !active;
    });
    if (view === 'map') initMap();
  }
  viewBtns.forEach(b => b.addEventListener('click', () => setView(b.dataset.viewButton!)));

  // ── Filter + search state ─────────────────────────────────────────────────────
  let allShops: any[] = [];
  let activeCategory  = 'all';
  let searchQuery     = '';

  function applyFilter() {
    const cards = grid.querySelectorAll<HTMLElement>('[data-filter-card]');
    let visible = 0;
    cards.forEach(card => {
      const catMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
      const searchMatch = !searchQuery || card.dataset.search!.includes(searchQuery);
      const show = catMatch && searchMatch;
      card.hidden = !show;
      if (show) visible++;
    });
    statusEl.textContent = labels.empty;
    statusEl.hidden = visible > 0;
  }

  function renderFilterBar(categories: { id: number; name_tr: string; name_en: string }[]) {
    const catName = (c: any) => locale === 'tr' ? c.name_tr : c.name_en;

    filterBar.innerHTML = `
      <div class="filter-controls">
        <div class="filter-chips" role="group" aria-label="Kategori filtresi">
          <button class="chip-btn is-active" data-cat="all">${labels.all}</button>
          ${categories.map(c => `<button class="chip-btn" data-cat="${catName(c).toLowerCase()}">${catName(c)}</button>`).join('')}
        </div>
        <div class="search-wrap">
          <input class="search-input" type="search" placeholder="${labels.search}" aria-label="${labels.search}" />
        </div>
      </div>
    `;

    filterBar.querySelectorAll<HTMLButtonElement>('.chip-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        filterBar.querySelectorAll('.chip-btn').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeCategory = btn.dataset.cat!;
        applyFilter();
      });
    });

    filterBar.querySelector<HTMLInputElement>('.search-input')?.addEventListener('input', e => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilter();
    });
  }

  // ── Card renderer ────────────────────────────────────────────────────────────
  function renderCard(shop: any): string {
    const cat     = locale === 'tr' ? (shop.category_tr || '') : (shop.category_en || '');
    const logo    = shop.logo_url
      ? `<img src="${shop.logo_url}" alt="${shop.name} logo" width="240" height="160" loading="lazy" />`
      : `<span class="logo-placeholder">${shop.name.charAt(0)}</span>`;
    const offer   = shop.discount || labels.noOffer;

    return `
      <article class="partner glass" data-filter-card data-category="${cat.toLowerCase()}" data-search="${shop.name.toLowerCase()} ${cat.toLowerCase()}">
        <div class="logo">${logo}</div>
        <div class="body">
          <span class="chip">${cat}</span>
          <h3>${shop.name}</h3>
          <p class="offer">${offer}</p>
          ${shop.website ? `<a class="shop-link" href="${shop.website}" target="_blank" rel="noopener">↗ Website</a>` : ''}
        </div>
      </article>
    `;
  }

  // ── Load data ────────────────────────────────────────────────────────────────
  try {
    const [shops, categories] = await Promise.all([
      fetch(`${API}/shops`).then(r => { if (!r.ok) throw new Error(); return r.json(); }),
      fetch(`${API}/shops/categories`).then(r => r.json()),
    ]);

    allShops = shops;

    // Render filter bar
    const usedCatIds = new Set(shops.map((s: any) => s.category_id));
    const usedCats   = categories.filter((c: any) => usedCatIds.has(c.id));
    renderFilterBar(usedCats);

    // Render cards (replace skeletons)
    if (shops.length === 0) {
      grid.innerHTML = '';
      statusEl.textContent = labels.empty;
      statusEl.hidden = false;
    } else {
      grid.innerHTML = shops.map(renderCard).join('');
    }

  } catch {
    grid.innerHTML = '';
    statusEl.textContent = labels.error;
    statusEl.hidden = false;
  }

  // ── Map view ─────────────────────────────────────────────────────────────────
  function loadMapbox(): Promise<any> {
    if ((window as any).mapboxgl) return Promise.resolve((window as any).mapboxgl);
    return new Promise((resolve, reject) => {
      if (!document.querySelector('link[data-mapbox-css]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://api.mapbox.com/mapbox-gl-js/v3.12.0/mapbox-gl.css';
        link.dataset.mapboxCss = 'true';
        document.head.appendChild(link);
      }
      const script = document.createElement('script');
      script.src = 'https://api.mapbox.com/mapbox-gl-js/v3.12.0/mapbox-gl.js';
      script.async = true;
      script.dataset.mapboxJs = 'true';
      script.onload = () => resolve((window as any).mapboxgl);
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  async function initMap() {
    if (mapStarted) return;
    mapStarted = true;
    const mapEl    = document.getElementById('partners-map')!;
    const msgEl    = document.getElementById('map-message')!;
    const listEl   = document.getElementById('map-list-items')!;
    const countEl  = document.getElementById('map-count')!;
    const token    = root.dataset.mapToken || '';

    if (!token) { msgEl.textContent = labels.mapToken; return; }

    // Filter shops with coordinates (address used as fallback label)
    const mappable = allShops.filter((s: any) => s.lat && s.lng);
    if (!mappable.length) {
      msgEl.textContent = labels.mapEmpty;
      listEl.innerHTML = `<p class="empty-map">${labels.mapEmpty}</p>`;
      countEl.textContent = '0';
      return;
    }

    countEl.textContent = `${mappable.length} ${locale === 'tr' ? 'konum' : 'locations'}`;

    try {
      const mapboxgl: any = await loadMapbox();
      mapboxgl.accessToken = token;
      const map = new mapboxgl.Map({
        container: mapEl,
        style: 'mapbox://styles/mapbox/dark-v11',
        center: [mappable[0].lng, mappable[0].lat],
        zoom: 12.2,
        scrollZoom: false,
      });
      map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
      map.on('load', () => {
        msgEl.hidden = true;
        const bounds = new mapboxgl.LngLatBounds();
        const markers = new Map<number, any>();
        mappable.forEach((s: any) => {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = 'map-logo-marker';
          el.setAttribute('aria-label', s.name);
          el.innerHTML = s.logo_url
            ? `<img src="${s.logo_url}" alt="${s.name}" />`
            : `<span>${s.name.charAt(0)}</span>`;
          const popup = new mapboxgl.Popup({ offset: 28, closeButton: true }).setHTML(
            `<div class="partner-popup">
              <div class="popup-head">${s.logo_url ? `<img src="${s.logo_url}" alt="${s.name}" />` : ''}<div><strong>${s.name}</strong><span>${locale === 'tr' ? (s.category_tr||'') : (s.category_en||'')}</span></div></div>
              ${s.discount ? `<p class="popup-offer">${s.discount}</p>` : ''}
              ${s.address ? `<p class="popup-location">⌖ ${s.address}</p>` : ''}
            </div>`
          );
          const marker = new mapboxgl.Marker({ element: el, anchor: 'center' })
            .setLngLat([s.lng, s.lat]).setPopup(popup).addTo(map);
          markers.set(s.id, marker);
          bounds.extend([s.lng, s.lat]);
        });
        if (mappable.length > 1) map.fitBounds(bounds, { padding: 70, maxZoom: 14 });

        listEl.innerHTML = mappable.map((s: any) => `
          <button type="button" class="map-list-item" data-shop-id="${s.id}">
            ${s.logo_url ? `<img src="${s.logo_url}" alt="${s.name}" width="44" height="44" loading="lazy" />` : `<span class="logo-placeholder-sm">${s.name.charAt(0)}</span>`}
            <span><b>${s.name}</b><small>${s.address || (locale === 'tr' ? s.category_tr : s.category_en) || ''}</small></span>
          </button>
        `).join('');

        listEl.querySelectorAll<HTMLButtonElement>('[data-shop-id]').forEach(btn => {
          btn.addEventListener('click', () => {
            const shop = mappable.find((s: any) => s.id === Number(btn.dataset.shopId));
            const marker = markers.get(Number(btn.dataset.shopId));
            if (!shop || !map) return;
            map.flyTo({ center: [shop.lng, shop.lat], zoom: 15, essential: true });
            marker?.togglePopup();
          });
        });
      });
    } catch {
      msgEl.textContent = locale === 'tr' ? 'Harita yüklenemedi.' : 'Map failed to load.';
    }
  }
})();
</script>

<style>
  /* ── Layout ─────────────────────────────────────────────────────────────── */
  .partners-page { position: relative }

  /* ── View toggle ─────────────────────────────────────────────────────────── */
  .view-toggle { display:flex; justify-content:center; gap:.7rem; flex-wrap:wrap; margin:2rem 0 0 }
  .view-button { display:inline-flex; align-items:center; justify-content:center; gap:.45rem; min-height:2.75rem; border:1px solid rgba(84,119,151,.18); border-radius:999px; background:rgba(255,255,255,.06); color:#d9e6f2; padding:.65rem 1.15rem; font-weight:850; cursor:pointer; transition:background .2s,border-color .2s,transform .2s,box-shadow .2s }
  .view-button svg { width:1rem; height:1rem; fill:currentColor; opacity:.95 }
  .view-button:hover { border-color:rgba(128,174,213,.45); transform:translateY(-1px) }
  .view-button.is-active { background:#071526; border-color:#071526; color:#fff; box-shadow:0 14px 34px rgba(0,0,0,.24) }
  .view-panel { margin-top:2rem }

  /* ── Dynamic filter bar ──────────────────────────────────────────────────── */
  .filter-space { margin-top:2rem }
  .filter-controls { display:flex; align-items:center; flex-wrap:wrap; gap:.8rem }
  .filter-chips { display:flex; flex-wrap:wrap; gap:.45rem }
  .chip-btn { display:inline-flex; align-items:center; height:2.1rem; border:1px solid rgba(84,119,151,.22); border-radius:999px; background:transparent; color:#a9bbce; padding:.3rem .85rem; font-size:.78rem; font-weight:600; cursor:pointer; transition:all .18s }
  .chip-btn:hover { border-color:rgba(128,174,213,.5); color:#fff }
  .chip-btn.is-active { background:var(--color-signal,#00d4ff); border-color:var(--color-signal,#00d4ff); color:#0a0f1e }
  .search-wrap { margin-left:auto }
  .search-input { height:2.1rem; padding:.3rem .85rem; background:rgba(255,255,255,.05); border:1px solid rgba(84,119,151,.22); border-radius:999px; color:#d9e6f2; font-size:.78rem; width:200px; outline:none; transition:border-color .18s }
  .search-input:focus { border-color:rgba(128,174,213,.5) }

  /* ── Grid cards ──────────────────────────────────────────────────────────── */
  .partner { display:grid; grid-template-columns:110px 1fr; align-items:center; gap:1.1rem; border-radius:1rem; padding:1rem }
  .logo { display:grid; place-items:center; aspect-ratio:1; border-radius:.75rem; background:#f2f3f4; overflow:hidden }
  .logo img { width:85%; height:85%; object-fit:contain }
  .logo-placeholder { width:100%; height:100%; display:grid; place-items:center; font-size:2rem; font-weight:700; color:#555; background:#eee }
  .body h3 { margin:.55rem 0 .1rem; font-size:1.15rem }
  .offer { margin:0; color:#d9e6f2; font-size:.88rem }
  .shop-link { display:inline-block; margin-top:.5rem; font-size:.75rem; color:var(--color-signal,#00d4ff); text-decoration:none }
  .shop-link:hover { text-decoration:underline }
  @media(max-width:420px) { .partner { grid-template-columns:85px 1fr } }

  /* ── Status message ──────────────────────────────────────────────────────── */
  .status-msg { margin:3rem auto; text-align:center; color:#a9bbce; font-size:.9rem }

  /* ── Skeleton loading ────────────────────────────────────────────────────── */
  .skeleton-card { display:grid; grid-template-columns:110px 1fr; gap:1.1rem; padding:1rem; border-radius:1rem; pointer-events:none }
  .skeleton-logo { border-radius:.75rem; background:rgba(255,255,255,.06); aspect-ratio:1; animation:shimmer 1.4s ease infinite }
  .skeleton-body { display:flex; flex-direction:column; gap:.6rem; justify-content:center }
  .skeleton-line { border-radius:6px; background:rgba(255,255,255,.06); height:.75rem; animation:shimmer 1.4s ease infinite }
  .skeleton-line.s-short { width:45% }
  .skeleton-line.s-long  { width:80% }
  .skeleton-line.s-med   { width:60% }
  @keyframes shimmer { 0%,100%{opacity:.4}50%{opacity:.8} }

  /* ── Map ─────────────────────────────────────────────────────────────────── */
  .map-shell { display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:1rem; border-radius:1.2rem; padding:1rem }
  .map-stage { position:relative; min-height:520px; overflow:hidden; border:1px solid rgba(84,119,151,.25); border-radius:1rem; background:rgba(3,7,13,.8) }
  #partners-map { position:absolute; inset:0 }
  .map-message { position:absolute; inset:0; display:grid; place-items:center; margin:0; padding:2rem; text-align:center; color:#a9bbce; background:rgba(3,7,13,.75) }
  .map-list { overflow:hidden; border:1px solid rgba(84,119,151,.22); border-radius:1rem; background:rgba(3,12,22,.72) }
  .map-list-head { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding:1rem; border-bottom:1px solid rgba(84,119,151,.18) }
  .map-list-head strong { display:block; color:#fff }
  .map-list-head span { color:#a9bbce; font-size:.78rem }
  .map-list-items { display:grid; gap:.5rem; max-height:458px; overflow-y:auto; padding:.75rem }
  .map-list-item { display:grid; grid-template-columns:44px minmax(0,1fr); align-items:center; gap:.7rem; width:100%; border:1px solid transparent; border-radius:.85rem; background:rgba(255,255,255,.04); color:#fff; padding:.55rem; text-align:left; cursor:pointer }
  .map-list-item:hover { border-color:rgba(128,174,213,.35); background:rgba(255,255,255,.08) }
  .map-list-item img { width:44px; height:44px; object-fit:contain; border-radius:.6rem; background:#fff; padding:.18rem }
  .logo-placeholder-sm { width:44px; height:44px; display:grid; place-items:center; border-radius:.6rem; background:#eee; color:#555; font-weight:700; font-size:1.1rem }
  .map-list-item b { display:block; font-size:.9rem }
  .map-list-item small { display:block; color:#a9bbce; font-size:.72rem }
  .empty-map { margin:0; padding:1rem; color:#a9bbce }
  @media(max-width:900px) { .map-shell { grid-template-columns:1fr } .map-stage { min-height:420px } .map-list-items { max-height:280px } }
  @media(max-width:560px) { .view-button { width:100%; justify-content:center } .map-stage { min-height:360px } }

  /* ── CTA ──────────────────────────────────────────────────────────────────── */
  .partners-cta { position:relative; display:grid; justify-items:center; gap:1rem; margin-top:2.2rem; text-align:center; padding:clamp(2rem,5vw,3.2rem) 1rem }
  .partners-cta::before { content:""; position:absolute; inset:0 50%; width:min(100%,820px); transform:translateX(-50%); border-radius:999px; background:radial-gradient(ellipse at center,rgba(5,11,20,.84),rgba(5,11,20,.52) 52%,transparent 76%); pointer-events:none }
  .partners-cta > * { position:relative; z-index:1 }
  .partners-cta h2 { margin:0; color:#fff; font-size:clamp(1.35rem,3vw,2rem) }
  .partners-cta p  { max-width:720px; margin:0; color:#a9bbce }
  .partners-cta .btn { white-space:nowrap }

  /* ── Mapbox popup overrides ───────────────────────────────────────────────── */
  :global(.mapboxgl-popup)         { max-width:min(245px,calc(100vw - 2rem))!important }
  :global(.mapboxgl-popup-content) { overflow:hidden!important; border:1px solid rgba(128,174,213,.24)!important; border-radius:.82rem!important; background:rgba(6,18,32,.96)!important; padding:0!important; color:#f5fbff!important }
  :global(.mapboxgl-popup-tip)     { border-top-color:rgba(6,18,32,.96)!important; border-bottom-color:rgba(6,18,32,.96)!important }
  :global(.partner-popup)          { min-width:210px; color:#f5fbff }
  :global(.popup-head)             { display:grid; grid-template-columns:42px 1fr; gap:.62rem; align-items:center; padding:.72rem .72rem .55rem }
  :global(.popup-head img)         { width:42px; height:42px; object-fit:contain; border-radius:.62rem; background:#fff; padding:.18rem }
  :global(.popup-head strong)      { display:block; color:#fff; font-size:.92rem }
