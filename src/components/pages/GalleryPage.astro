---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../ui/PageHero.astro';
import FilterControls from '../ui/FilterControls.astro';
import { gallery as staticGallery } from '../../data/gallery';
import { t } from '../../lib/content';
import type { Locale } from '../../types/content';

interface Props { locale: Locale; }
const { locale } = Astro.props;

let rawGallery: any[] = [];
try {
  const response = await fetch('https://admin.sastek.org/api/gallery', {
    headers: { 'Accept': 'application/json' },
  });
  if (response.ok) {
    const apiItems = await response.json();
    if (Array.isArray(apiItems) && apiItems.length > 0) {
      rawGallery = apiItems.map((item: any) => {
        const rawTag = (item.event_tag || '').trim();
        return {
          id: String(item.id),
          src: item.url,
          category: { tr: rawTag, en: rawTag },
          order: item.id,
        };
      });
    }
  }
} catch (e) {
  // Use static fallback if API fails
}

if (!rawGallery.length) {
  rawGallery = staticGallery.map((g, idx) => ({
    id: g.id,
    src: g.src,
    category: {
      tr: (t(g.category, 'tr') || '').trim(),
      en: (t(g.category, 'en') || '').trim(),
    },
    order: g.order || idx + 1,
  }));
}

const categories = [...new Set(rawGallery.map((item) => (t(item.category, locale) || '').trim()).filter(Boolean))];
const title = locale === 'tr' ? 'Galeri' : 'Gallery';
const desc  = locale === 'tr' ? 'Etkinliklerden, teknik buluşmalardan ve kulüp yaşamından seçilmiş anlar.' : 'Selected moments from events, technical meetups and club life.';
---

<BaseLayout title={title} description={desc} locale={locale}>
  <PageHero eyebrow={locale === 'tr' ? 'SASTEK / GALERİ' : 'SASTEK / GALLERY'} title={title} text={desc} />
  <section class="section">
    <div class="container" data-filter-root data-gallery-root data-locale={locale} data-api="https://admin.sastek.org/api">
      <FilterControls locale={locale} categories={categories} showSearch={false} allLabel={locale === 'tr' ? 'Tüm etiketler' : 'All tags'} />
      <div class="gallery-grid" id="gallery-grid-container">
        {rawGallery.map((item, index) => {
          const categoryName = (t(item.category, locale) || '').trim();
          const accessibleAlt = locale === 'tr' ? 'SASTEK galeri fotoğrafı' : 'SASTEK gallery photo';
          return (
            <button
              type="button"
              data-filter-card
              data-category={categoryName.toLowerCase()}
              data-search={categoryName.toLowerCase()}
              data-lightbox-src={item.src.startsWith('/images/') ? 'https://sastek.org' + item.src : item.src}
              aria-label={`${locale === 'tr' ? 'Görseli büyüt' : 'Enlarge image'}${categoryName ? `: ${categoryName}` : ''}`}
            >
              <img src={item.src.startsWith('/images/') ? 'https://sastek.org' + item.src : item.src} alt={accessibleAlt} width="720" height="520" loading={index > 1 ? 'lazy' : 'eager'} />
              {categoryName ? <span>{categoryName}</span> : null}
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 4.3: Gelişmiş Navigasyonlu Lightbox -->
  <dialog id="lightbox" aria-label={locale === 'tr' ? 'Galeri görseli' : 'Gallery image'}>
    <button class="close" aria-label={locale === 'tr' ? 'Kapat' : 'Close'}>
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="lightbox-body">
      <button id="lb-prev" class="lightbox-nav prev" type="button" aria-label={locale === 'tr' ? 'Önceki fotoğraf' : 'Previous photo'}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-stage">
        <img id="lb-image" alt={locale === 'tr' ? 'Seçilen galeri görseli' : 'Selected gallery image'} />
      </div>

      <button id="lb-next" class="lightbox-nav next" type="button" aria-label={locale === 'tr' ? 'Sonraki fotoğraf' : 'Next photo'}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="lightbox-foot">
      <span id="lb-counter" class="lightbox-counter"></span>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
  const image = document.querySelector<HTMLImageElement>('#lb-image');
  const counter = document.querySelector<HTMLElement>('#lb-counter');
  const prevBtn = document.querySelector<HTMLButtonElement>('#lb-prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('#lb-next');
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('.close');

  let currentGalleryItems: { src: string }[] = [];
  let currentActiveIndex = 0;

  function updateActiveItems() {
    const visibleButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-grid button[data-lightbox-src]'))
      .filter((btn) => btn.offsetParent !== null); // Sadece filtrelenip ekranda görünenler

    currentGalleryItems = visibleButtons.map((btn) => ({
      src: btn.dataset.lightboxSrc ?? '',
    }));
  }

  function displayImage(index: number) {
    if (!currentGalleryItems.length || !image || !dialog) return;

    // Döngüsel indeks (başa/sona sarma)
    currentActiveIndex = (index + currentGalleryItems.length) % currentGalleryItems.length;
    const current = currentGalleryItems[currentActiveIndex];

    image.src = current.src;
    if (counter) counter.textContent = `${currentActiveIndex + 1} / ${currentGalleryItems.length}`;
  }

  function bindLightboxButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach((button) => {
      button.onclick = () => {
        updateActiveItems();
        const clickedSrc = button.dataset.lightboxSrc;
        const foundIndex = currentGalleryItems.findIndex((item) => item.src === clickedSrc);

        displayImage(foundIndex !== -1 ? foundIndex : 0);
        dialog?.showModal();
      };
    });
  }
  bindLightboxButtons();

  // Önceki / Sonraki Tıklama
  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    displayImage(currentActiveIndex - 1);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    displayImage(currentActiveIndex + 1);
  });

  // Kapatma
  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => {
    if (image) {
      image.removeAttribute('src');
      image.alt = '';
    }
  });

  // Dışarı tıklanınca kapat (stage / body dışı)
  dialog?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === dialog || target.classList.contains('lightbox-body') || target.classList.contains('lightbox-stage')) {
      dialog.close();
    }
  });

  // Fotoğrafa tıklanınca modalın kapanmasını engelle
  image?.addEventListener('click', (e) => {
    e.stopPropagation();
  });

  // Klavye Navigasyonu (Ok tuşları)
  window.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'ArrowLeft') {
      displayImage(currentActiveIndex - 1);
    } else if (e.key === 'ArrowRight') {
      displayImage(currentActiveIndex + 1);
    }
  });

  // Dokunmatik Swipe Desteği (Mobil)
  let touchStartX = 0;
  dialog?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].clientX;
  }, { passive: true });

  dialog?.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].clientX;
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 45) {
      if (diff > 0) {
        displayImage(currentActiveIndex - 1); // Sağa kaydır = önceki
      } else {
        displayImage(currentActiveIndex + 1); // Sola kaydır = sonraki
      }
    }
  }, { passive: true });

  // ── Live Client-Side Hydration ────────────────────────────────────────────────
  (async () => {
    const root = document.querySelector<HTMLElement>('[data-gallery-root]');
    if (!root) return;
    const pageLocale = (root.dataset.locale || 'tr') as 'tr' | 'en';
    const apiBase = root.dataset.api || 'https://admin.sastek.org/api';
    const gridContainer = document.getElementById('gallery-grid-container');
    if (!gridContainer) return;

    function escapeHtml(value: string) {
      return String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] || char));
    }

    try {
      const res = await fetch(`${apiBase}/gallery`);
      if (!res.ok) return;
      const items = await res.json();
      if (!Array.isArray(items)) return;

      if (items.length === 0) {
        gridContainer.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:#a9bbce;margin:2rem auto">${pageLocale === 'tr' ? 'Galeride gösterilecek fotoğraf yok.' : 'No photos in gallery.'}</p>`;
        return;
      }

      gridContainer.innerHTML = items.map((item: any, index: number) => {
        const rawTag = (item.event_tag || '').trim();
        const accessibleAlt = pageLocale === 'tr' ? 'SASTEK galeri fotoğrafı' : 'SASTEK gallery photo';
        let src = item.url;
        if (src.startsWith('/images/')) src = 'https://sastek.org' + src;

        const catHtml = rawTag ? `<span>${escapeHtml(rawTag)}</span>` : '';
        const catAttr = rawTag ? escapeHtml(rawTag.toLowerCase()) : '';

        return `<button
          type="button"
          data-filter-card
          data-category="${catAttr}"
          data-search="${escapeHtml(rawTag.toLowerCase())}"
          data-lightbox-src="${escapeHtml(src)}"
          aria-label="${pageLocale === 'tr' ? 'Görseli büyüt' : 'Enlarge image'}${rawTag ? `: ${escapeHtml(rawTag)}` : ''}"
        >
          <img src="${escapeHtml(src)}" alt="${escapeHtml(accessibleAlt)}" width="720" height="520" loading="${index > 1 ? 'lazy' : 'eager'}" />
          ${catHtml}
        </button>`;
      }).join('');

      bindLightboxButtons();

      const categorySelect = root.querySelector<HTMLSelectElement>('[data-filter-category]');
      if (categorySelect) {
        const existingVal = categorySelect.value;
        const apiCategories = [...new Set(items.map((item: any) => (item.event_tag || '').trim()).filter(Boolean))];
        const defaultAllLabel = pageLocale === 'tr' ? 'Tüm etiketler' : 'All tags';
        categorySelect.innerHTML = `<option value="">${defaultAllLabel}</option>` +
          apiCategories.map((c: string) => `<option value="${escapeHtml(c.toLowerCase())}">${escapeHtml(c)}</option>`).join('');
        categorySelect.value = existingVal;
        categorySelect.dispatchEvent(new Event('change', { bubbles: true }));
      }
    } catch {}
  })();
</script>

<style>
  :global(.gallery-grid) {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 260px;
    gap: 1rem;
  }
  :global(.gallery-grid button) {
    position: relative;
    grid-column: span 5;
    overflow: hidden;
    border: 1px solid rgba(84, 119, 151, .25);
    border-radius: 1rem;
    background: #071526;
    padding: 0;
    cursor: zoom-in;
  }
  :global(.gallery-grid button:nth-child(3n+1)) {
    grid-column: span 7;
  }
  :global(.gallery-grid img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s;
  }
  :global(.gallery-grid button:hover img) {
    transform: scale(1.03);
  }
  :global(.gallery-grid span) {
    position: absolute;
    left: .8rem;
    bottom: .8rem;
    border-radius: 999px;
    background: rgba(5, 11, 20, .8);
    backdrop-filter: blur(8px);
    padding: .3rem .75rem;
    font-size: .72rem;
    font-weight: 800;
    color: #e3edf7;
  }

  /* ── 4.3 Lightbox Dialog & Navigation ──────────────────────────────── */
  dialog {
    position: fixed;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: min(1180px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2.5rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(0, 212, 255, .25);
    border-radius: 1.25rem;
    background: rgba(4, 11, 20, .96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding: clamp(.75rem, 2vw, 1.25rem);
    box-shadow: 0 28px 90px rgba(0, 0, 0, .8), 0 0 40px rgba(0, 212, 255, .08);
    display: none;
    grid-template-rows: 1fr auto;
    gap: .75rem;
    box-sizing: border-box;
  }
  dialog[open] {
    display: grid;
  }
  dialog::backdrop {
    background: rgba(1, 4, 9, .88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* 3 Sütunlu Lightbox Gövdesi: [ ← ] [ Fotoğraf ] [ → ] */
  .lightbox-body {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 52px;
    align-items: center;
    gap: .75rem;
    width: 100%;
    min-height: 0;
    max-height: calc(100dvh - 8.5rem);
  }

  .lightbox-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    max-height: calc(100dvh - 8.5rem);
    min-height: 0;
    min-width: 0;
    overflow: hidden;
  }
  .lightbox-stage img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 8.5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: .75rem;
    user-select: none;
  }

  /* Kapat Butonu */
  .close {
    position: absolute;
    right: 1rem;
    top: 1rem;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(0, 212, 255, .25);
    border-radius: 50%;
    background: rgba(7, 21, 38, .85);
    color: #e3edf7;
    font-size: 1.4rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background .2s, border-color .2s, color .2s, transform .2s, box-shadow .2s;
  }
  .close:hover {
    background: rgba(255, 107, 26, .2);
    border-color: #ff6b1a;
    color: #ff9a62;
    transform: scale(1.06);
    box-shadow: 0 0 14px rgba(255, 107, 26, .35);
  }
  .close:focus-visible {
    outline: 2px solid #00d4ff;
    outline-offset: 2px;
  }

  /* Ok Butonları (Prev / Next) - Fotoğrafın Dışında */
  .lightbox-nav {
    position: static;
    transform: none;
    justify-self: center;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid rgba(0, 212, 255, .3);
    border-radius: 50%;
    background: rgba(6, 17, 30, .85);
    backdrop-filter: blur(12px);
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .4);
    transition: border-color .2s, background .2s, transform .2s, color .2s, box-shadow .2s;
    flex-shrink: 0;
  }
  .lightbox-nav:hover {
    border-color: #00d4ff;
    background: rgba(0, 212, 255, .16);
    color: #00d4ff;
    transform: scale(1.08);
    box-shadow: 0 0 16px rgba(0, 212, 255, .35);
  }
  .lightbox-nav:active {
    transform: scale(0.96);
  }
  .lightbox-nav:focus-visible {
    outline: 2px solid #00d4ff;
    outline-offset: 2px;
  }

  /* Alt Bilgi & Sayaç */
  .lightbox-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: .35rem 0 0;
    border-top: 1px solid rgba(0, 212, 255, .12);
  }
  .lightbox-counter {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .8rem;
    font-weight: 700;
    color: #00d4ff;
    letter-spacing: .08em;
    padding: .2rem .75rem;
    border-radius: 999px;
    background: rgba(0, 212, 255, .08);
    border: 1px solid rgba(0, 212, 255, .18);
  }

  @media (max-width: 700px) {
    :global(.gallery-grid) {
      grid-template-columns: 1fr;
      grid-auto-rows: 230px;
    }
    :global(.gallery-grid button),
    :global(.gallery-grid button:nth-child(3n+1)) {
      grid-column: auto;
    }
    dialog {
      width: calc(100vw - 1rem);
      max-height: calc(100dvh - 1rem);
      padding: .6rem;
      gap: .5rem;
    }
    .lightbox-body {
      grid-template-columns: 42px minmax(0, 1fr) 42px;
      gap: .35rem;
      max-height: calc(100dvh - 6.5rem);
    }
    .lightbox-stage {
      max-height: calc(100dvh - 6.5rem);
    }
    .lightbox-stage img {
      max-height: calc(100dvh - 6.5rem);
    }
    .lightbox-nav {
      width: 2.5rem;
      height: 2.5rem;
    }
    .lightbox-nav svg {
      width: 18px;
      height: 18px;
    }
    .close {
      right: .5rem;
      top: .5rem;
      width: 2.2rem;
      height: 2.2rem;
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-nav,
    .close,
    :global(.gallery-grid img) {
      transition: none;
      transform: none;
    }
    .lightbox-nav:hover,
    .close:hover {
      transform: none;
    }
  }
</style>
