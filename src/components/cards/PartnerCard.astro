---
import { t } from '../../lib/content';
import type { Locale, Partner } from '../../types/content';

interface Props { partner: Partner; locale: Locale; originalIndex?: number; }
const { partner, locale, originalIndex = 0 } = Astro.props;

function extractDiscountPercent(text: string | null | undefined): number | null {
  if (!text) return null;
  const match = text.match(/(?:%\s*(\d+(?:[.,]\d+)?))|(?:(\d+(?:[.,]\d+)?)\s*%)/);
  if (match) {
    const rawNum = match[1] || match[2];
    const parsed = parseFloat(rawNum.replace(',', '.'));
    if (!isNaN(parsed) && parsed > 0) return parsed;
  }
  return null;
}

const discountStr = t(partner.discountLabel, locale);
const discountPercent = extractDiscountPercent(discountStr);
const categoryStr = t(partner.category, locale);
const hasLogo = Boolean(partner.logo && partner.logo.trim());
const initialLetter = (partner.name || 'S').trim().charAt(0).toUpperCase();
---

<article
  class="partner glass"
  data-filter-card
  data-category={categoryStr.toLowerCase()}
  data-search={`${partner.name} ${categoryStr} ${discountStr}`.toLowerCase()}
  data-name={partner.name}
  data-discount-percent={discountPercent !== null ? String(discountPercent) : ''}
  data-original-index={String(originalIndex)}
  data-order={String(partner.order ?? originalIndex)}
>
  <div class="logo">
    {hasLogo ? (
      <>
        <div class="logo-backdrop" style={`background-image: url('${partner.logo}')`}></div>
        <img src={partner.logo} alt={`${partner.name} logo`} width="240" height="160" loading="lazy" />
      </>
    ) : (
      <div class="logo-fallback" aria-hidden="true">
        <span class="fallback-letter">{initialLetter}</span>
      </div>
    )}
  </div>
  <div class="body">
    <div class="meta">
      <span class="chip">{categoryStr}</span>
    </div>
    <h3>{partner.name}</h3>
    <p class="offer">{discountStr}</p>
    {!partner.isVerified && <p class="verify">● {locale === 'tr' ? 'Doğrulama bekliyor' : 'Awaiting verification'}</p>}
  </div>
</article>

<style>
  .partner {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 104px 1fr;
    align-items: center;
    gap: 1.25rem;
    border-radius: 1.25rem;
    padding: 1.15rem 1.25rem;
    transition: border-color .25s ease, transform .25s ease, background .25s ease, box-shadow .25s ease;
  }

  /* EventCard ile aynı derin uzay ambient ışıltısı */
  .partner::after {
    content: "";
    position: absolute;
    right: -4rem;
    bottom: -4.5rem;
    width: 11rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 107, 26, .09), transparent 66%);
    pointer-events: none;
  }

  .partner:hover {
    border-color: rgba(0, 212, 255, .32);
    background: linear-gradient(145deg, rgba(16, 43, 70, .78), rgba(7, 21, 38, .86));
    box-shadow: 0 24px 60px -10px rgba(0, 0, 0, .5), 0 0 25px -5px rgba(0, 212, 255, .07);
    transform: translateY(-4px);
  }

  .logo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 1rem;
    background: #071526;
    border: 1px solid rgba(130, 164, 196, .28);
    box-shadow: 0 10px 24px -6px rgba(0, 0, 0, .4);
    overflow: hidden;
    box-sizing: border-box;
  }

  .logo-backdrop {
    position: absolute;
    inset: -10px;
    background-size: cover;
    background-position: center;
    filter: blur(14px) brightness(0.4) saturate(1.2);
    transform: scale(1.2);
    opacity: 0.65;
    pointer-events: none;
  }

  .logo img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    object-position: center;
    display: block;
    transition: transform .25s ease;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.45));
  }

  .partner:hover .logo img {
    transform: scale(1.06);
  }

  .logo-fallback {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 30% 30%, rgba(0, 212, 255, 0.18), rgba(7, 21, 38, 0.95));
  }

  .fallback-letter {
    font-size: 2.2rem;
    font-weight: 800;
    color: #00d4ff;
    letter-spacing: -0.03em;
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.45);
    user-select: none;
  }

  .body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .6rem;
  }

  .chip {
    border: 1px solid rgba(128, 174, 213, .28);
    background: rgba(128, 174, 213, .08);
    color: #dce9f5;
    font-size: .74rem;
    font-weight: 650;
    padding: .2rem .6rem;
    border-radius: 999px;
  }

  .body h3 {
    margin: .45rem 0 .2rem;
    font-size: clamp(1.1rem, 1.8vw, 1.22rem);
    font-weight: 700;
    letter-spacing: -.02em;
    color: #ffffff;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .offer {
    margin: 0;
    color: #d9e6f2;
    font-size: .88rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .verify {
    margin: .35rem 0 0;
    color: #8fa6bb;
    font-size: .72rem;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .partner {
      grid-template-columns: 88px 1fr;
      gap: 1rem;
      padding: 1rem;
    }
    .body h3 {
      font-size: 1.1rem;
    }
  }
</style>
