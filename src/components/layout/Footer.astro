---
import { navigation } from '../../data/navigation';
import { site } from '../../data/site';
import { socials as staticSocials } from '../../data/socials';
import { t } from '../../lib/content';
import type { Locale } from '../../types/content';
import SocialIcon from '../ui/SocialIcon.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;

let rawSocials: any[] = [];
try {
  const res = await fetch('https://admin.sastek.org/api/socials', { headers: { 'Accept': 'application/json' } });
  if (res.ok) {
    const apiSocials = await res.json();
    if (Array.isArray(apiSocials) && apiSocials.length > 0) rawSocials = apiSocials;
  }
} catch (e) {}

if (!rawSocials.length) {
  rawSocials = staticSocials.map(s => ({
    id: s.id,
    platform: s.platform,
    label: s.label,
    url: s.url,
    icon: s.icon,
    order_num: s.order,
    is_active: s.isActive ? 1 : 0
  }));
}

const activeSocials = rawSocials.filter((item) => (item.is_active === 1 || item.is_active === true) && item.url && item.url !== '#');
---

<footer>
  <div class="container footer-grid" data-footer-root data-api="https://admin.sastek.org/api">
    <div>
      <div class="footer-brand">SASTEK<span>.</span></div>
      <p class="muted">{t(site.fullName, locale)}<br />{t(site.institution, locale)}</p>
    </div>
    <nav aria-label={locale === 'tr' ? 'Alt menü' : 'Footer menu'}>
      {navigation.slice(1).map((item) => <a href={item[locale]}>{t(item.label, locale)}</a>)}
    </nav>
    <div>
      <p class="eyebrow">{locale === 'tr' ? 'Bağlantıda kal' : 'Stay connected'}</p>
      <div class="socials" id="footer-socials-container">
        {activeSocials.length > 0 ? activeSocials.map((item) => (
          <a href={item.url} rel="noreferrer" target="_blank" aria-label={`${item.label} ${locale === 'tr' ? 'sayfasını yeni sekmede aç' : 'opens in a new tab'}`}>
            <SocialIcon icon={item.icon || item.platform.toLowerCase()} />
            <span>{item.label}</span>
          </a>
        )) : <p class="muted small">{locale === 'tr' ? 'Sosyal medya bağlantıları güncellenecek.' : 'Social links will be updated.'}</p>}
      </div>
    </div>
  </div>
  <div class="container copyright">
    <p class="text-sm text-white/50">
      &copy; {new Date().getFullYear()} SASTEK. {locale === 'tr' ? 'Tüm hakları saklıdır.' : 'All rights reserved.'} | Developed by <a href="https://github.com/ardauca" target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-[#ff6b1a] transition-colors underline underline-offset-4">Arda Uça</a>
    </p>
  </div>
</footer>

<script>
  (async () => {
    const root = document.querySelector<HTMLElement>('[data-footer-root]');
    if (!root) return;
    const apiBase = root.dataset.api || 'https://admin.sastek.org/api';
    const container = document.getElementById('footer-socials-container');
    if (!container) return;

    function escapeHtml(val: string) {
      return String(val).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c] || c));
    }

    function getSocialIconSvg(iconKey: string) {
      const k = (iconKey || '').toLowerCase();
      if (k === 'instagram') return `<svg aria-hidden="true" viewBox="0 0 24 24" class="social-icon"><path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5ZM12 7.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 2a2.9 2.9 0 1 0 0 5.8 2.9 2.9 0 0 0 0-5.8Zm5.15-2.35a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z" /></svg>`;
      if (k === 'linkedin') return `<svg aria-hidden="true" viewBox="0 0 24 24" class="social-icon"><path d="M4.98 3.5a2.48 2.48 0 1 1 0 4.96 2.48 2.48 0 0 1 0-4.96ZM3 9.25h3.96V21H3V9.25Zm6.25 0h3.79v1.6h.05c.53-1 1.82-2.05 3.75-2.05 4.01 0 4.75 2.64 4.75 6.07V21h-3.95v-5.44c0-1.3-.02-2.97-1.81-2.97-1.82 0-2.1 1.42-2.1 2.88V21H9.25V9.25Z" /></svg>`;
      if (k === 'youtube') return `<svg aria-hidden="true" viewBox="0 0 24 24" class="social-icon"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.13C19.55 3.57 12 3.57 12 3.57s-7.55 0-9.4.5A3 3 0 0 0 .5 6.2 31.1 31.1 0 0 0 0 12a31.1 31.1 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.13c1.85.5 9.4.5 9.4.5s7.55 0 9.4-.5a3 3 0 0 0 2.1-2.13A31.1 31.1 0 0 0 24 12a31.1 31.1 0 0 0-.5-5.8ZM9.6 15.57V8.43L15.86 12 9.6 15.57Z" /></svg>`;
      if (k === 'x' || k === 'twitter') return `<svg aria-hidden="true" viewBox="0 0 24 24" class="social-icon"><path d="M18.9 2.25h3.68l-8.04 9.19L24 21.75h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 2.25h7.59l5.24 6.92 6.07-6.92Zm-1.29 17.68h2.04L6.48 3.97H4.29l13.32 15.96Z" /></svg>`;
      return `<svg aria-hidden="true" viewBox="0 0 24 24" class="social-icon"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7a5.1 5.1 0 0 0-5.1 5.1D5.1 5.1 0 0 0 7 17.1h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4a5.1 5.1 0 0 0 5.1-5.1A5.1 5.1 0 0 0 17 7z"/></svg>`;
    }

    try {
      const res = await fetch(`${apiBase}/socials`);
      if (!res.ok) return;
      const socials = await res.json();
      if (!Array.isArray(socials) || socials.length === 0) return;

      container.innerHTML = socials.map((s: any) => `
        <a href="${escapeHtml(s.url)}" rel="noreferrer" target="_blank" aria-label="${escapeHtml(s.label)}">
          ${getSocialIconSvg(s.icon || s.platform)}
          <span>${escapeHtml(s.label)}</span>
        </a>
      `).join('');
    } catch {}
  })();
</script>

<style>
  footer { border-top: 1px solid rgba(84,119,151,.22); padding: 4rem 0 1.5rem; background: rgba(3,8,15,.7); }
  .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 3rem; }
  .footer-brand { font-size: 1.6rem; font-weight: 950; letter-spacing: -.04em; }.footer-brand span { color: #ff6b1a; }
  nav { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem 1rem; } nav a { color: #a9bbce; font-size: .9rem; } nav a:hover { color: #fff; }
  :global(.socials) { display: flex; gap: .7rem; flex-wrap: wrap; }
  :global(.socials a) { display: inline-flex; align-items: center; gap: .48rem; min-height: 2.9rem; padding: .78rem 1.05rem; border: 1px solid rgba(84,119,151,.75); border-radius: 999px; color: #fff; font-weight: 850; line-height: 1; background: rgba(7,22,38,.35); text-decoration: none; }
  :global(.socials a:hover) { border-color: rgba(255,107,26,.75); color: #fff; background: rgba(255,107,26,.08); transform: translateY(-1px); }
  :global(.socials .social-icon) { width: 1rem; height: 1rem; fill: currentColor; flex: 0 0 auto; }
  .small{font-size:.9rem}.copyright { margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid rgba(84,119,151,.18); color: #72889d; font-size: .78rem; }
  @media(max-width:760px){.footer-grid{grid-template-columns:1fr}.footer-grid nav{grid-template-columns:1fr 1fr}}
</style>
