---
import { navigation } from '../../data/navigation';
import { t } from '../../lib/content';
import type { Locale } from '../../types/content';

interface Props { locale: Locale; currentPath: string; }
const { locale, currentPath } = Astro.props;
const detailMatch = locale === 'tr'
  ? currentPath.match(/^\/etkinlikler\/([^/]+)$/)
  : currentPath.match(/^\/en\/events\/([^/]+)$/);
const languageTarget = detailMatch
  ? (locale === 'tr' ? `/en/events/${detailMatch[1]}` : `/etkinlikler/${detailMatch[1]}`)
  : locale === 'tr'
    ? (navigation.find((item) => item.tr === currentPath)?.en ?? '/en')
    : (navigation.find((item) => item.en === currentPath)?.tr ?? '/');
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href={locale === 'tr' ? '/' : '/en'} aria-label="SASTEK">
      <img src="/images/logo/sastek-logo.png" alt="SASTEK Logo" width="132" height="46" />
      <span>SASTEK</span>
    </a>

    <!-- Masaüstü Menü -->
    <nav class="desktop-nav" aria-label={locale === 'tr' ? 'Ana menü' : 'Main menu'}>
      {navigation.map((item) => {
        const href = item[locale] as string;
        const active = currentPath === href || (href !== '/' && href !== '/en' && currentPath.startsWith(`${href}/`));
        return (
          <a href={href} aria-current={active ? 'page' : undefined} class={active ? 'active' : ''}>
            {t(item.label, locale)}
          </a>
        );
      })}
    </nav>

    <a class="lang" href={languageTarget} hreflang={locale === 'tr' ? 'en' : 'tr'}>
      {locale === 'tr' ? 'EN' : 'TR'}
    </a>

    <!-- Mobil Hamburger Butonu -->
    <button
      id="mobile-toggle-btn"
      class="mobile-toggle"
      aria-label={locale === 'tr' ? 'Menüyü aç/kapat' : 'Toggle menu'}
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>
  </div>

  <!-- Mobil Menü Tam Ekran Paneli (iPhone Uyumlu, Saydam Olmayan Tok Zemin) -->
  <div id="mobile-nav-panel" class="mobile-nav-panel" aria-label={locale === 'tr' ? 'Mobil menü' : 'Mobile menu'}>
    <div class="mobile-nav-inner container">
      <nav class="mobile-links">
        {navigation.map((item) => {
          const href = item[locale] as string;
          const active = currentPath === href || (href !== '/' && href !== '/en' && currentPath.startsWith(`${href}/`));
          return (
            <a href={href} class={`mobile-link ${active ? 'active' : ''}`}>
              <span class="link-text">{t(item.label, locale)}</span>
              <span class="link-arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </nav>

      <div class="mobile-nav-footer">
        <a class="mobile-lang-btn" href={languageTarget}>
          <span class="globe-icon" aria-hidden="true">🌐</span>
          <span>{locale === 'tr' ? 'English Version' : 'Türkçe Sürüm'}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  (() => {
    const toggleBtn = document.getElementById('mobile-toggle-btn');
    const navPanel = document.getElementById('mobile-nav-panel');
    const siteHeader = document.getElementById('site-header');
    const links = document.querySelectorAll('.mobile-link');

    if (!toggleBtn || !navPanel) return;

    function openNav() {
      navPanel!.classList.add('is-open');
      toggleBtn!.classList.add('is-active');
      toggleBtn!.setAttribute('aria-expanded', 'true');
      siteHeader?.classList.add('menu-open');
      document.body.style.overflow = 'hidden';
    }

    function closeNav() {
      navPanel!.classList.remove('is-open');
      toggleBtn!.classList.remove('is-active');
      toggleBtn!.setAttribute('aria-expanded', 'false');
      siteHeader?.classList.remove('menu-open');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (navPanel!.classList.contains('is-open')) {
        closeNav();
      } else {
        openNav();
      }
    });

    // Menüdeki linke tıklandığında menüyü kapat
    links.forEach((link) => {
      link.addEventListener('click', closeNav);
    });

    // ESC ile kapat
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navPanel!.classList.contains('is-open')) {
        closeNav();
      }
    });

    // Ekran 1040px üstüne çıktığında menüyü kapat
    window.addEventListener('resize', () => {
      if (window.innerWidth > 1040 && navPanel!.classList.contains('is-open')) {
        closeNav();
      }
    }, { passive: true });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(84, 119, 151, .2);
    background: #030811;
    transition: background .2s ease;
  }

  .header-inner {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    font-weight: 900;
    letter-spacing: .08em;
    color: #fff;
  }
  .brand img {
    width: 2.7rem;
    height: 2.7rem;
    object-fit: contain;
  }
  .brand span {
    font-size: 1.15rem;
  }

  /* ── Desktop Navigation ────────────────────────────────────────────── */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.45rem;
    margin-left: auto;
  }

  .desktop-nav a {
    position: relative;
    padding: .4rem .1rem;
    color: #b2c4d6;
    font-size: .88rem;
    font-weight: 750;
    white-space: nowrap;
    transition: color .2s ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: #ffffff;
  }

  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -.4rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #ff6b1a, #ff9a62);
    box-shadow: 0 0 10px rgba(255, 107, 26, .55);
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity .2s ease, transform .2s ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(84, 119, 151, .5);
    border-radius: 999px;
    padding: .35rem .75rem;
    color: #ff9a62;
    font-size: .75rem;
    font-weight: 900;
    letter-spacing: .08em;
    background: rgba(7, 21, 38, .4);
    transition: border-color .2s, background .2s, color .2s, transform .2s;
  }
  .lang:hover {
    border-color: #ff6b1a;
    background: rgba(255, 107, 26, .1);
    color: #fff;
    transform: translateY(-1px);
  }

  /* ── Mobil Hamburger Butonu ────────────────────────────────────────── */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: .5rem;
    margin-left: auto;
    width: 44px;
    height: 44px;
    position: relative;
    z-index: 60;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-toggle .bar {
    display: block;
    width: 24px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform .25s ease, opacity .25s ease;
    margin: 5px auto;
  }

  .mobile-toggle.is-active .bar-1 {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-toggle.is-active .bar-2 {
    opacity: 0;
  }
  .mobile-toggle.is-active .bar-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── iPhone Uyumlu Tam Ekran Mobil Panel (Saydam Değil, Katı Zemin) ─ */
  .mobile-nav-panel {
    display: none;
    position: fixed;
    top: 4.75rem;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: calc(100dvh - 4.75rem);
    background: #040c18; /* Tamamen opak, arkası kesinlikle görünmez */
    border-top: 1px solid rgba(84, 119, 151, .25);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    z-index: 55;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom, 1rem));
  }

  .mobile-nav-panel.is-open {
    display: block;
    animation: mobile-fade-in .22s ease-out;
  }

  @keyframes mobile-fade-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    padding-top: 1.25rem;
    padding-bottom: 2rem;
    min-height: 100%;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    flex: 1;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1rem;
    border-bottom: 1px solid rgba(84, 119, 151, .15);
    color: #e6f0fa;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -.01em;
    text-decoration: none;
    transition: color .15s, background .15s;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-link:active,
  .mobile-link.active {
    color: #ff9a62;
    background: rgba(255, 107, 26, .08);
  }

  .link-arrow {
    font-size: 1.2rem;
    color: #537596;
    transition: transform .2s, color .2s;
  }
  .mobile-link:active .link-arrow,
  .mobile-link.active .link-arrow {
    color: #ff9a62;
    transform: translateX(4px);
  }

  .mobile-nav-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(84, 119, 151, .2);
  }

  .mobile-lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    width: 100%;
    min-height: 3.25rem;
    border: 1px solid rgba(84, 119, 151, .4);
    border-radius: 999px;
    background: rgba(7, 21, 38, .75);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 750;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-lang-btn:active {
    border-color: #ff6b1a;
    background: rgba(255, 107, 26, .15);
  }
  .globe-icon {
    font-size: 1.15rem;
  }

  @media (max-width: 1040px) {
    .desktop-nav, .header-inner > .lang {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
  }
</style>
